# Bhoomi FastAPI backend base URL.
# When reachable, the landing page pulls the live officer/agronomist queues
# and answers the voice-query demo from the real API. When it isn't (or when
# any call errors), the page falls back to the bundled local demo data —
# see src/data/farmStore.js — so the pitch deck still renders standalone.
VITE_API_BASE_URL=http://localhost:8000

# Demo credentials seeded by `make seed` / `scripts/seed_full_demo.py` in
# services/api. Used only to obtain read-only JWTs for the public dashboard
# previews below — never a real login form.
VITE_DEMO_FARMER_PHONE=+919944400001
VITE_DEMO_OFFICER_PHONE=+919944400002
VITE_DEMO_AGRONOMIST_PHONE=+919944400003
VITE_DEMO_PASSWORD=bhoomi123

# Set to 'false' to force the bundled local demo data even when the API is
# reachable (useful for pitching offline).
VITE_ENABLE_LIVE_API=true
