# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/bhoomi

# Security & JWT Auth
JWT_SECRET_KEY=bhoomi-super-secret-key-change-in-production-sih25076
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Object Storage (MinIO / S3 / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bhoomi-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# LLM & Embedding Service
LLM_PROVIDER=stub        # groq | stub -- 'groq' requires a real LLM_API_KEY (fails at startup otherwise)
LLM_API_KEY=mock-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=claude-3-5-sonnet-20241022  # set to e.g. llama-3.3-70b-versatile when LLM_PROVIDER=groq
EMBEDDING_MODEL=BAAI/bge-m3  # descriptive only — not read anywhere; see services/api/.env.example for the flag that matters

# Backing service for EMBEDDING_PROVIDER=bge_m3 and DIAGNOSIS_MODEL=real —
# both call out to this URL rather than loading heavy ML weights in-process.
ML_SERVICE_URL=http://localhost:8001

# Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Feature Flags
PROBLEM_STATEMENT=sih26131  # sih26131 (default: mounts alerts + efficacy) | sih25076 (demo fallback). land, officer, resource_plan, schemes mount in both modes.
DIAGNOSIS_MODEL=stub     # real | stub -- 'real' calls out to ML_SERVICE_URL above instead of returning a canned confidence
# EMBEDDING_PROVIDER: bge_m3 | stub -- bge_m3 is NOT a safe standalone flip:
# it requires services/ml running and reachable at ML_SERVICE_URL, with
# services/ml/requirements-embeddings.txt installed (sentence-transformers +
# torch, ~5GB with CUDA) and the ~2.2GB BGE-m3 weights actually downloaded.
# If services/ml falls back to hash vectors, every RAG call 503s instead of
# silently retrieving against the wrong embedding space (see
# services/api/app/adapters/embeddings_real.py). See services/api/.env.example
# for the full explanation.
EMBEDDING_PROVIDER=stub

# Hard Rule Operating Thresholds
CONFIDENCE_GATE=0.70     # Below this threshold, diagnosis auto-escalates


# ==========================================
# Frontend & Mobile Configuration
# ==========================================

# Farmer Mobile App (Flutter)
# Pass via: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
BHOOMI_API_BASE_URL=http://localhost:8000

# KVK Agronomist Portal (Vite React)
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=true

# Officer Revenue Portal (Vite React)
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=true

