# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bhoomi

# Security & JWT Auth
JWT_SECRET_KEY=bhoomi-super-secret-key-change-in-production-sih25076
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Object Storage (MinIO / S3 / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bhoomi-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# LLM & Embedding Service
LLM_API_KEY=mock-llm-api-key
LLM_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=BAAI/bge-m3

# Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Feature Flags
LAND_API_MODE=mock       # mock | live
DIAGNOSIS_MODEL=stub     # real | stub

# Hard Rule Operating Thresholds
CONFIDENCE_GATE=0.70     # Below this threshold, diagnosis auto-escalates
RAG_RELEVANCE_THRESHOLD=0.18 # Tuned (Phase 3) against the stub embedding + seed corpus; re-tune when a real EmbeddingPort lands

# Voice / ASR / TTS Providers (ASR_PROVIDER: stub | bhashini | whisper | sarvam)
ASR_PROVIDER=stub
TTS_PROVIDER=stub

# Bhashini API (optional — needed only when ASR_PROVIDER/TTS_PROVIDER = bhashini)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Sarvam AI API (optional — needed only when ASR_PROVIDER/TTS_PROVIDER = sarvam)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

