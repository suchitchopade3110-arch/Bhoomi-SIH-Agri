# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bhoomi

# Security & JWT Auth
JWT_SECRET_KEY=bhoomi-super-secret-key-change-in-production-sih25076
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage backend: 'local' (default — zero infra, serves files from this API
# itself under PUBLIC_BASE_URL) | 's3' (real S3/MinIO via the STORAGE_* vars
# below). See app/adapters/dependencies.py::get_storage_adapter().
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# Public base URL the *client* (Flutter app / portals) uses to reach this
# API — used to build absolute asset URLs (e.g. synthesized TTS audio) that
# actually resolve from the caller's network. Keep this equal to whatever
# host the Flutter app's API_BASE_URL points at; "localhost" only works when
# client and server are the same machine.
PUBLIC_BASE_URL=http://localhost:8000

# Object Storage (MinIO / S3 / Cloudflare R2) — only used when STORAGE_BACKEND=s3.
# STORAGE_ENDPOINT must also be reachable by the client, not just the backend.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=bhoomi-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_SECURE=false

# LLM & Embedding Service
LLM_PROVIDER=stub        # groq | stub -- 'groq' requires a real LLM_API_KEY (fails at startup otherwise)
LLM_API_KEY=mock-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=claude-3-5-sonnet-20241022  # set to e.g. llama-3.3-70b-versatile when LLM_PROVIDER=groq
EMBEDDING_MODEL=BAAI/bge-m3  # descriptive only — not read anywhere; the model actually used lives in services/ml, not this value

# EMBEDDING_PROVIDER: 'stub' (default, token-hashing vectors, always available)
# | 'bge_m3' (real dense embeddings — calls out to services/ml's /embed).
# IMPORTANT: setting bge_m3 here is NOT a safe standalone flip. It requires,
# in order: (1) services/ml actually running and reachable at ML_SERVICE_URL
# below; (2) that process has services/ml/requirements-embeddings.txt
# installed (sentence-transformers + torch — ~5GB with CUDA, or a lighter
# CPU-only torch build); (3) the BGE-m3 weights (~2.2GB) downloaded from
# Hugging Face Hub on first use, which needs real internet egress from
# wherever services/ml runs. If services/ml is reachable but reports it
# fell back to hash vectors (weights/deps unavailable), every RAG call
# raises a 503 EMBEDDING_PROVIDER_UNAVAILABLE instead of silently retrieving
# against the wrong embedding space — see app/adapters/embeddings_real.py
# and app/core/errors.py. Only set bge_m3 once all three are actually true;
# otherwise this breaks RAG rather than improving it.
EMBEDDING_PROVIDER=stub
# Backing service for EMBEDDING_PROVIDER=bge_m3 and DIAGNOSIS_MODEL=real —
# both call out to this URL rather than loading heavy ML weights in-process.
ML_SERVICE_URL=http://localhost:8001

# Weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Feature Flags
# PROBLEM_STATEMENT is pinned explicitly here rather than left to the code
# default (app/core/config.py also defaults to sih26131) so the contract this
# deployment serves is visible in the file the demo box actually runs from.
#   sih26131 -> mounts alerts + efficacy (this is what the demo runs)
#   sih25076 -> those two features answer 501 FEATURE_NOT_AVAILABLE; see
#               docs/specs/problem_statement_flag_off_contract.md
# resource_plan and schemes mount in both modes.
PROBLEM_STATEMENT=sih26131
DIAGNOSIS_MODEL=stub     # real | stub -- 'real' calls out to ML_SERVICE_URL above instead of returning a canned confidence

# Hard Rule Operating Thresholds
CONFIDENCE_GATE=0.70     # Below this threshold, diagnosis auto-escalates
# RAG_RELEVANCE_THRESHOLD is a read-only computed value in code (auto-picks
# 0.18 stub-tuned vs 0.60 production-tuned based on EMBEDDING_PROVIDER above)
# — setting "RAG_RELEVANCE_THRESHOLD" here does nothing (silently ignored).
# To force a specific value regardless of EMBEDDING_PROVIDER, set the real
# field instead:
# RAG_RELEVANCE_THRESHOLD_OVERRIDE=0.18

# Voice / ASR / TTS Providers: stub | bhashini | sarvam (TTS also allows 'gtts')
# Both default to 'sarvam' — Sarvam AI is the provider actually used here.
# get_speech_adapter() fails loudly at startup if SARVAM_API_KEY is unset
# rather than silently degrading to the stub — set it below, or set both
# back to 'stub' explicitly for local dev without credentials.
ASR_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# Bhashini API (optional — needed only when ASR_PROVIDER/TTS_PROVIDER = bhashini)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Sarvam AI API — required with the ASR_PROVIDER/TTS_PROVIDER defaults above
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

