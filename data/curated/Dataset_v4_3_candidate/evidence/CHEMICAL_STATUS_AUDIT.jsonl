{"chemical_id": "CHEM-001", "active_ingredient": "Chlorantraniliprole", "formulation": "18.5 SC", "target_type": "pest", "targets": ["Stem borer", "Leaf folder"], "dosage": "150 ml/ha in 500 L water (Knapsack) or 150 ml/ha in 20-25 L water (Drone ULV)", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 47, "risk_classification": "Green Label (Low mammalian toxicity)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_pest.html", "verification_date": "2026-08-24", "notes": "CIBRC registered for Rice Stem Borer and Leaf Folder. Safe to natural enemies. Drone application approved @ 20-25 L/ha with VMD 100-150 µm and wind < 10 km/h."}
{"chemical_id": "CHEM-002", "active_ingredient": "Buprofezin", "formulation": "25 SC", "target_type": "pest", "targets": ["Brown planthopper (BPH)", "Green leafhopper (GLH)"], "dosage": "400-800 ml/ha in 500 L water", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 30, "risk_classification": "Blue Label (Insect Growth Regulator)", "source_organization": "CIBRC / IRRI", "source_url": "https://www.knowledgebank.irri.org/", "verification_date": "2026-08-24", "notes": "CIBRC approved for rice hoppers. Direct spray to base of tillers."}
{"chemical_id": "CHEM-003", "active_ingredient": "Imidacloprid", "formulation": "17.8 SL", "target_type": "pest", "targets": ["Green leafhopper (GLH)", "Brown planthopper (BPH)"], "dosage": "100-125 ml/ha in 500 L water", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 21, "risk_classification": "Yellow Label (Neonicotinoid)", "source_organization": "CIBRC / ICAR-IIRR", "source_url": "https://iirr.icar.gov.in/", "verification_date": "2026-08-24", "notes": "Approved for rice hoppers; suppresses GLH vector to prevent Tungro virus transmission."}
