{"chemical_id": "CHEM-010", "active_ingredient": "Hexaconazole", "formulation": "5 SC / 5 EC", "target_type": "disease", "targets": ["Sheath Blight", "Stem Rot"], "dosage": "1000 ml/ha in 500 L water directed at plant base", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 30, "risk_classification": "Green Label (Triazole)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_diseases.html", "verification_date": "2026-08-24", "notes": "Systemic triazole fungicide targeting ergosterol biosynthesis. Approved for Sheath Blight and Stem Rot."}
{"chemical_id": "CHEM-011", "active_ingredient": "Validamycin", "formulation": "3 L", "target_type": "disease", "targets": ["Sheath Blight", "Stem Rot"], "dosage": "1000 ml/ha in 500 L water directed at waterline", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 14, "risk_classification": "Green Label (Antibiotic/Fungicide)", "source_organization": "CIBRC / IRRI", "source_url": "https://www.knowledgebank.irri.org/", "verification_date": "2026-08-24", "notes": "Antibiotic fungicide derived from Streptomyces hygroscopicus; inhibits trehalase."}
{"chemical_id": "CHEM-012", "active_ingredient": "Azoxystrobin + Difenoconazole", "formulation": "18.2% + 11.4% SC (29.6 SC)", "target_type": "disease", "targets": ["Sheath Blight", "Rice Blast"], "dosage": "500 ml/ha in 500 L water (Knapsack) or 500 ml/ha in 25 L water (Drone ULV)", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 31, "risk_classification": "Blue Label (Strobilurin + Triazole)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_diseases.html", "verification_date": "2026-08-24", "notes": "Broad-spectrum combination with dual translaminar and systemic modes of action. CIBRC drone label approved."}
{"chemical_id": "CHEM-013", "active_ingredient": "Propiconazole", "formulation": "25 EC", "target_type": "disease", "targets": ["Sheath Rot", "False Smut"], "dosage": "500 ml/ha in 500 L water", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 30, "risk_classification": "Yellow Label (Triazole)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_diseases.html", "verification_date": "2026-08-24", "notes": "Approved for sheath rot and false smut. Must be applied at 50% boot leaf stage; post-flowering sprays strictly prohibited."}
{"chemical_id": "CHEM-014", "active_ingredient": "Streptocycline + Copper Oxychloride", "formulation": "90:10 SP + 50 WP", "target_type": "disease", "targets": ["Bacterial Leaf Blight (BLB)"], "dosage": "100 g + 500 g per hectare", "crop": "Rice (Oryza sativa)", "cibrc_status": "Restricted / Under Review", "regulatory_status": "RESTRICTED", "phi_days": 30, "risk_classification": "Red/Yellow Label (Agricultural Antibiotic)", "source_organization": "CIBRC / DPPQS", "source_url": "https://ppqs.gov.in/", "verification_date": "2026-08-24", "notes": "Streptocycline is an antibiotic subject to Antimicrobial Resistance (AMR) regulatory restrictions in Indian agriculture. Non-antibiotic alternatives (Copper Hydroxide) preferred."}
