{"chemical_id": "CHEM-006", "active_ingredient": "Malathion", "formulation": "50 EC", "target_type": "pest", "targets": ["Earhead bug"], "dosage": "500-1000 ml/ha in 500 L water", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved with Strict PHI", "regulatory_status": "RESTRICTED", "phi_days": 10, "risk_classification": "Blue Label (Organophosphate)", "source_organization": "CIBRC / ICAR-IIRR", "source_url": "https://iirr.icar.gov.in/", "verification_date": "2026-08-24", "notes": "Applied during grain milking; high grain residue risk. Mandatory minimum 7-10 days PHI."}
{"chemical_id": "CHEM-007", "active_ingredient": "Copper hydroxide", "formulation": "77 WP", "target_type": "disease", "targets": ["Bacterial Leaf Blight (BLB)", "False Smut", "Bacterial Leaf Streak (BLS)"], "dosage": "1.25 kg/ha in 500 L water (Knapsack) or 1.25 kg/ha in 25 L water (Drone ULV)", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 15, "risk_classification": "Blue Label (Inorganic Copper)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_diseases.html", "verification_date": "2026-08-24", "notes": "Approved for bacterial blight and false smut. Apply preventively at boot leaf stage before flowering."}
{"chemical_id": "CHEM-008", "active_ingredient": "Tricyclazole", "formulation": "75 WP", "target_type": "disease", "targets": ["Rice Blast (Leaf & Neck)"], "dosage": "500 g/ha (0.6 g/L water)", "crop": "Rice (Oryza sativa)", "cibrc_status": "Approved", "regulatory_status": "VERIFIED_CURRENT", "phi_days": 30, "risk_classification": "Blue Label (Triazole)", "source_organization": "CIBRC / TNAU", "source_url": "https://agritech.tnau.ac.in/crop_protection/rice_diseases.html", "verification_date": "2026-08-24", "notes": "Gold standard blasticide; highly systemic; prevents appressorial melanization."}
